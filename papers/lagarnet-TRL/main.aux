\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textcolor {revblue}{Simulation results for single-arm pick-and-place (\text  {PnP}) controllers. \textbf  {(a)} Per-horizon longsleeve flattening: \textcolor {irevgreen}{Rows denote methods (identified by legend markers). Each horizon $N \in \{5, 10, 20, 30\}$ spans two columns: \emph  {Max} (the highest value achieved within $N$ steps, representing cumulative success for SR) and \emph  {Last} (the exact value at step $N$). Cell shading visually reinforces the printed scores.} Only the single-arm PnP primitive of \text  {ClothFunnels}~\cite  {canberk2023cloth} is enabled; \text  {Diffusion Policy}~\cite  {kadi2025draper, chi2023diffusionpolicy} is trained on 200 human demonstrations, and \text  {MEDOR}~\cite  {huang2022mesh} is evaluated on cropped observations (Section \ref {sec:baseline}). NC and Max IoU barely change between Max and Last, whereas SR drops sharply (Section \ref {sec:discussion}). \textbf  {(b)} Performance on all four garment types by action step 20, where \text  {LaGarNet} consistently outperforms all-garment \text  {PlaNet-ClothPick} and task-specific \text  {Diffusion Policy}.}}}{7}{figure.caption.3}\protected@file@percent }
\newlabel{fig:sim-results}{{3}{7}{\rev {Simulation results for single-arm pick-and-place (\text {PnP}) controllers. \textbf {(a)} Per-horizon longsleeve flattening: \irev {Rows denote methods (identified by legend markers). Each horizon $N \in \{5, 10, 20, 30\}$ spans two columns: \emph {Max} (the highest value achieved within $N$ steps, representing cumulative success for SR) and \emph {Last} (the exact value at step $N$). Cell shading visually reinforces the printed scores.} Only the single-arm PnP primitive of \text {ClothFunnels}~\cite {canberk2023cloth} is enabled; \text {Diffusion Policy}~\cite {kadi2025draper, chi2023diffusionpolicy} is trained on 200 human demonstrations, and \text {MEDOR}~\cite {huang2022mesh} is evaluated on cropped observations (Section \ref {sec:baseline}). NC and Max IoU barely change between Max and Last, whereas SR drops sharply (Section \ref {sec:discussion}). \textbf {(b)} Performance on all four garment types by action step 20, where \text {LaGarNet} consistently outperforms all-garment \text {PlaNet-ClothPick} and task-specific \text {Diffusion Policy}.}}{figure.caption.3}{}}
\newlabel{fig:sim-results@cref}{{[figure][3][]3}{[1][6][]7}}
