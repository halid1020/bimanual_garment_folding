\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Real-world garment flattening performance of different pick-and-place controllers. \textcolor {revblue}{Each block is an evaluation horizon, and every value is cumulative over that horizon rather than the value at the final step: NC, NI and Max IoU give the best reached within the first 10 or 20 actions, and SR the fraction of trials meeting both criteria at any step up to that point. We report no final-step column here. Each cell already averages only ten physical trials, so a single final-step mean would be noisy, and the failure analysis of Figure \ref {tab:failure-rates} measures end-state behaviour more directly: four of 40 trajectories reach a success state without holding it. } LaGarNet shows substantial performance improvements across all garments compared to PlaNet-ClothPick, though it still falls short of human-level performance.}}{10}{table.caption.7}\protected@file@percent }
\newlabel{tab:real-worldflattening}{{II}{10}{Real-world garment flattening performance of different pick-and-place controllers. \rev {Each block is an evaluation horizon, and every value is cumulative over that horizon rather than the value at the final step: NC, NI and Max IoU give the best reached within the first 10 or 20 actions, and SR the fraction of trials meeting both criteria at any step up to that point. We report no final-step column here. Each cell already averages only ten physical trials, so a single final-step mean would be noisy, and the failure analysis of Figure \ref {tab:failure-rates} measures end-state behaviour more directly: four of 40 trajectories reach a success state without holding it. } LaGarNet shows substantial performance improvements across all garments compared to PlaNet-ClothPick, though it still falls short of human-level performance}{table.caption.7}{}}
\newlabel{tab:real-worldflattening@cref}{{[table][2][]II}{[1][9][]10}}
