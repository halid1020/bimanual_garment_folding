\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Comprehensive ablation study for LaGarNet in simulation environments. \textbf  {(a, b, c, and d)} Ablation study using the all-garment LaGarNet models; each component contributes to flattening performance, and Section \ref {sec:abl} ranks them. \textbf  {(e)} Observation reconstruction quality of models from Figure (a); each grid is a 64$\times $64 RGB image. The green arrows in the first row represent pick-and-place actions; our GC-RSSM model demonstrates a superior ability to track garment sleeves in prior steps compared to other RSSM variants. \textcolor {revblue}{\textbf  {(f)} Flattening performance against the MPC planning horizon $H$, reported both cumulatively (\emph  {Max}) and at the final step; hollow markers report the unconstrained-CEM variant at $H=1$. \textbf  {(g)} The reconstructions of (e) scored by Mean Squared Error (MSE) and Structural Similarity Index (SSIM) \cite  {wang2004image}, both $\times $100 and averaged over 10 trials per garment; SSIM captures the local structure and contrast that blurring degrades. GC-RSSM reduces blurriness in the multi-step prior reconstructions.}}}{9}{figure.caption.6}\protected@file@percent }
\newlabel{fig:ablation-and-recon-combined}{{5}{9}{Comprehensive ablation study for LaGarNet in simulation environments. \textbf {(a, b, c, and d)} Ablation study using the all-garment LaGarNet models; each component contributes to flattening performance, and Section \ref {sec:abl} ranks them. \textbf {(e)} Observation reconstruction quality of models from Figure (a); each grid is a 64$\times $64 RGB image. The green arrows in the first row represent pick-and-place actions; our GC-RSSM model demonstrates a superior ability to track garment sleeves in prior steps compared to other RSSM variants. \rev {\textbf {(f)} Flattening performance against the MPC planning horizon $H$, reported both cumulatively (\emph {Max}) and at the final step; hollow markers report the unconstrained-CEM variant at $H=1$. \textbf {(g)} The reconstructions of (e) scored by Mean Squared Error (MSE) and Structural Similarity Index (SSIM) \cite {wang2004image}, both $\times $100 and averaged over 10 trials per garment; SSIM captures the local structure and contrast that blurring degrades. GC-RSSM reduces blurriness in the multi-step prior reconstructions.}}{figure.caption.6}{}}
\newlabel{fig:ablation-and-recon-combined@cref}{{[figure][5][]5}{[1][8][]9}}
